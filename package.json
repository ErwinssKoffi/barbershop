{
  "name": "salon-pro",
  "private": true,
  "version": "1.0.0",
  "description": "SALON PRO — Application locale de gestion financière et administrative d'un salon de coiffure (FCFA, IndexedDB/Dexie)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:public-access-concurrency": "node --experimental-strip-types scripts/testPublicAccessConcurrency.ts",
    "preview": "vite preview",
    "db:migrations:plan": "node --experimental-strip-types server/migrationPlanCli.ts",
    "db:check": "node --experimental-strip-types server/checkDatabaseCli.ts",
    "db:migrate": "node --experimental-strip-types server/migrate.ts",
    "db:schema": "node --experimental-strip-types server/exportSchema.ts",
    "db:schema:check": "node --experimental-strip-types server/exportSchema.ts --check",
    "platform:activate": "node --experimental-strip-types server/platformActivationCli.ts",
    "cloud:check": "node --experimental-strip-types server/checkCloudCli.ts",
    "test:financial": "vitest run src/test/financialReconciliation.test.ts src/test/financialReconciliationUi.test.tsx src/test/financialAcceptance.test.ts src/test/checkoutCommit.test.ts src/test/checkoutRefund.test.ts src/test/checkoutStatus.test.ts src/test/checkoutCutover.test.ts src/test/checkoutCutoverLocal.test.ts src/test/checkoutQueueIntegration.test.ts src/test/sessions.test.ts src/test/cloudReadiness.test.ts"
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.8.0",
    "lucide-react": "^1.64.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": "22.x"
  }
}
