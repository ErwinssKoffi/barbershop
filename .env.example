# Développement : copier ce modèle dans .env.local (ignoré par Git), puis redémarrer.
# Vérification sans migration : npm run db:check. Les variables de déploiement sont prioritaires.
# Secrets côté serveur uniquement — NE JAMAIS préfixer par VITE_.
# Choisir UNE connexion. Supabase est prioritaire si les deux sont renseignées.
DATABASE_URL=""
# Copier l’URI PostgreSQL depuis Supabase > Connect (pooler session recommandé).
# Les tables SALON PRO sont dans le schéma privé salon_pro, pas dans public.
SUPABASE_DATABASE_URL=""

# Générer une clé aléatoire forte ; conserver la même sur toutes les instances.
SALON_AUTH_SECRET=""

# Pilote UI uniquement, non secret. Activer après migration 006 et recette backup/restore.
# Aucun repli local automatique en cas de refus de checkout/commit.
VITE_SERVER_CHECKOUT=false

# Serveur : rester legacy tant que TOUS les appareils/backlogs ne sont pas rapprochés.
# enforced bloque atomiquement les mutations de ventes par /api/sync (006 requise).
SALON_CHECKOUT_SYNC_MODE=legacy
# Approbation opérateur après prévol, sauvegardes et restauration vérifiées ; ce n'est pas une preuve automatique.
SALON_CHECKOUT_CUTOVER_APPROVED=false

# Agenda interne optionnel : après sauvegarde/restauration vérifiées et migration 008.
# Indépendant de la caisse ; ne pas activer automatiquement en production.
SALON_BOOKING_ENABLED=false
VITE_BOOKING_ENABLED=false
# --include-booking exige SALON_BOOKING_BACKUP_VERIFIED=true (accord opérateur, pas une preuve).
